# aider / ИИ-хелперы
.aider*
.aider.tags.cache.v4/

# Служебный вывод проверки сайта (_verify_site.py)
_vs.txt

# Python
__pycache__/
*.py[cod]
*.spec

# Сборка лаунчера
build/
dist/

# Логи и кэш лаунчера
data/launcher.log*
data/install_test.log
data/cache/

# Личные файлы — не публикуются в репозитории
# (если они уже отслеживаются git, выполните: git rm --cached <файл>)
data/accounts.json
data/settings.json
data/donations.json
data/versions_cache.json
instances/

# Игровые файлы внутри сборок (на случай, если папка instances всё же в индексе)
instances/*/logs/
instances/*/versions/
instances/*/libraries/
instances/*/assets/
instances/*/runtime/
instances/*/downloads/
instances/*/crash-reports/
instances/*/saves/
instances/*/mods/
instances/*/resourcepacks/
instances/*/shaderpacks/
instances/*/backups/
instances/*/hs_err_pid*
instances/*/options.txt
instances/*/*.log

